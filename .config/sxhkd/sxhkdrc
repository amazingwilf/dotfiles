## Keybindings config for Archcraft's BSPWM

##---------- Keybindings for bspwm ----------##

# Terminal (alacritty)
super + Return
	ghostty

# Rofi App Launcher
alt + F1
	rofi -show drun -kb-cancel Alt-F1

# Launch Apps
super + w
	firefox

super + e
	thunar

super + o
	thunderbird

XF86MonBrightness{Up,Down}
	brightness{ --inc, --dec}
	
# Speaker Volume control
XF86Audio{RaiseVolume,LowerVolume}
	volume{ --inc, --dec}

# Mic Volume control
XF86Audio{Mute,MicMute}
	volume{ --toggle, --toggle-mic}
	
# Music control
XF86Audio{Next,Prev,Play,Stop}
	mpc {next,prev,toggle,stop}

# Reload Keybindings
super + Escape
	pkill -USR1 -x sxhkd
